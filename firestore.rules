rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function activeUser() { return signedIn() && myUser().active == true; }
    function roleIs(roleName) { return activeUser() && myUser().role == roleName; }
    function anyRole(roles) { return activeUser() && myUser().role in roles; }
    function admin() { return roleIs("Administrator"); }
    function management() { return anyRole(["Administrator", "School Head"]); }
    function supplyStaff() { return anyRole(["Administrator", "School Head", "Supply Officer"]); }
    function propertyStaff() { return anyRole(["Administrator", "Property Custodian"]); }
    function hrStaff() { return anyRole(["Administrator", "HR/Admin"]); }
    function staff() { return anyRole(["Administrator", "School Head", "Supply Officer", "Property Custodian", "HR/Admin"]); }

    match /users/{userId} {
      allow read: if activeUser() && (request.auth.uid == userId || staff());
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.role == "Employee"
                    && request.resource.data.active == true;
      allow update: if admin()
                    || (activeUser()
                        && request.auth.uid == userId
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.email == resource.data.email
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.active == resource.data.active);
      allow delete: if false;
    }

    match /supplyRequests/{requestId} {
      allow create: if activeUser()
                    && request.resource.data.requesterUid == request.auth.uid
                    && request.resource.data.status == "Pending";
      allow read: if activeUser() && (resource.data.requesterUid == request.auth.uid || supplyStaff());
      allow update: if supplyStaff();
      allow delete: if false;
    }

    match /borrowTransactions/{transactionId} {
      allow create: if activeUser()
                    && ((request.resource.data.borrowerUid == request.auth.uid
                         && request.resource.data.status == "Requested")
                        || propertyStaff());
      allow read: if activeUser()
                  && (resource.data.borrowerUid == request.auth.uid
                      || propertyStaff()
                      || roleIs("School Head"));
      allow update: if propertyStaff();
      allow delete: if false;
    }

    match /dtrRecords/{recordId} {
      allow read: if activeUser()
                  && (resource.data.employeeUid == request.auth.uid
                      || hrStaff()
                      || roleIs("School Head"));
      allow create, update: if hrStaff();
      allow delete: if false;
    }

    match /leaveApplications/{leaveId} {
      allow create: if activeUser()
                    && request.resource.data.employeeUid == request.auth.uid
                    && request.resource.data.status == "Pending";
      allow read: if activeUser()
                  && (resource.data.employeeUid == request.auth.uid
                      || hrStaff()
                      || roleIs("School Head"));
      allow update: if hrStaff() || roleIs("School Head");
      allow delete: if false;
    }

    match /settings/{documentId} {
      allow read: if activeUser();
      allow write: if admin();
    }

    match /auditLogs/{logId} {
      allow create: if activeUser()
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.actorEmail == request.auth.token.email;
      allow read: if management();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
